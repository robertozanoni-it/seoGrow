PORT=8787
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=4000
OPENAI_MONTHLY_BUDGET_USD=10
OPENAI_BILLING_TIME_ZONE=Europe/Rome
OPENAI_MAX_REQUEST_COST_USD=0.25
# Aggiorna queste tariffe se cambi modello (costo per 1 milione di token).
OPENAI_INPUT_COST_PER_MILLION_USD=0.25
OPENAI_OUTPUT_COST_PER_MILLION_USD=2
PAID_REQUEST_LIMIT=30
APP_API_TOKEN=
# AVVIA.command imposta automaticamente l'origine della porta scelta.
# Per npm run dev/start viene usata http://localhost:5176.
APP_ORIGIN=http://localhost:5176
DATAFORSEO_MONTHLY_BUDGET_USD=25
DATAFORSEO_BILLING_TIME_ZONE=Europe/Rome
DATAFORSEO_MAX_SERP_COST_USD=0.10
DATAFORSEO_MAX_LABS_COST_USD=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
