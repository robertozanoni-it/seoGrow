{
  "name": "seogrow-ai-mvp",
  "private": true,
  "version": "1.4.3",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "cross-env APP_ORIGIN=http://localhost:5176 NODE_OPTIONS=--import=./server/wordpressRemediationHook.js\ --import=./server/frontendVerificationHook.js concurrently --kill-others-on-fail \"vite --port 5176 --strictPort\" \"node server/index.js\"",
    "build": "vite build",
    "start": "cross-env APP_ORIGIN=http://localhost:5176 NODE_OPTIONS=--import=./server/wordpressRemediationHook.js\ --import=./server/frontendVerificationHook.js concurrently --kill-others-on-fail \"vite preview --host 127.0.0.1 --port 5176 --strictPort\" \"node server/index.js\"",
    "preview": "vite preview --host 127.0.0.1 --port 5176 --strictPort",
    "lint": "eslint .",
    "test": "node --test src/*.test.js",
    "test:launcher": "zsh -n AVVIA.command"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jszip": "3.10.1",
    "lucide-react": "1.40.0",
    "papaparse": "5.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "prettier": "3.6.2"
  }
}
